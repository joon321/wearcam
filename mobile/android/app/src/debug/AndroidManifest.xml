<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET is needed by the Flutter development tool for debugging. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only debug builds may reach a backend on the phone's local network.
         Profile and release builds retain Android's cleartext prohibition. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
