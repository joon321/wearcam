# Server-only permanent credential. Never copy this into Flutter or dart-define.
OPENAI_API_KEY=sk-your-project-key
PORT=8787
NODE_ENV=development
# Use the exact HTTPS origin of your deployed client; "*" is rejected in production.
ALLOWED_ORIGIN=https://wearcam.example.com
OPENAI_REALTIME_MODEL=gpt-realtime
# Optional override for test/proxy deployments.
OPENAI_API_BASE_URL=https://api.openai.com
